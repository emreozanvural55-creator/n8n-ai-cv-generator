        "jsCode": "const markdown = $json.data || $json.output || \"\";\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n\n<style>\n\nbody{\nfont-family:Arial,Helvetica,sans-serif;\nmargin:40px;\nline-height:1.6;\ncolor:#222;\n}\n\nh1{\nfont-size:32px;\nborder-bottom:3px solid #0F62FE;\npadding-bottom:10px;\nmargin-bottom:25px;\n}\n\nh2{\ncolor:#0F62FE;\nmargin-top:30px;\nborder-bottom:1px solid #ddd;\npadding-bottom:5px;\n}\n\nstrong{\ncolor:#111;\n}\n\nul{\npadding-left:22px;\n}\n\nli{\nmargin-bottom:6px;\n}\n\n</style>\n\n</head>\n\n<body>\n\n${markdown}\n\n</body>\n\n</html>\n`;\n\nreturn [\n{\njson:{\nhtml\n}\n}\n];"
